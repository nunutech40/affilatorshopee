PORT=8080
DATABASE_URL=postgres://affiliator:change-me@db:5432/affiliator?sslmode=disable
POSTGRES_USER=affiliator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=affiliator
STORAGE_PATH=/app/data/uploads
# AI_API_KEY bisa diisi OpenRouter key ATAU OpenCode Zen key.
# Jika kosong, backend akan coba baca ~/.local/share/opencode/auth.json (auth session opencode ini) otomatis.
# Untuk Muse Spark 1.2 gratis, gunakan key dari `opencode auth` yang sudah login.
AI_API_KEY=
# Default muse spark contributor free (gratis, data training). Bisa diganti per-request via dropdown di UI.
OPENROUTER_MODEL=opencode/muse-spark-1.2-contributor-free
ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
