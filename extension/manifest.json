{
  "manifest_version": 3,
  "name": "AffiliatorShopee Helper",
  "version": "1.8.0",
  "description": "Auto-paste caption dari AffiliatorShopee ke composer X/Threads",
  "permissions": ["activeTab", "storage", "scripting", "clipboardWrite", "clipboardRead"],
  "host_permissions": ["https://twitter.com/*", "https://x.com/*", "https://threads.net/*", "http://localhost:8080/*", "http://127.0.0.1:8080/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*", "https://threads.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Attach media AffiliatorShopee"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
